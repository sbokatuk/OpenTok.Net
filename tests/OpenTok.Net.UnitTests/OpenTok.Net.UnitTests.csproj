<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Checks the repository’s own bookkeeping — packages.tsv against src/, the .sln, the version pins —
    none of which needs anything built. Plain net9.0 with no workloads: these tests read files
    off disk and never load a platform assembly.
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
