<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runs against the packed .nupkg in artifacts/, not against the binding project, so it catches
    packaging regressions the compiler cannot see. Plain net9.0 with no workloads: these tests
    read the package zip directly rather than loading the binding assembly.
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
