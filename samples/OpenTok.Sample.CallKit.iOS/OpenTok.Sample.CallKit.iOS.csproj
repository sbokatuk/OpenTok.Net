<Project Sdk="Microsoft.NET.Sdk">

  <!--
    An iOS-only sample: CallKit integration.

    Not a target framework of the cross-platform sample, and not an #if branch of it. CXProvider and
    Android's ConnectionService share a purpose and nothing else — different registration, different
    lifecycles, different threading — so an app doing either writes platform code either way. What
    the two samples *do* share is the audio handshake, OpenTokAudioSession, which both call
    identically; that is the part the façade could honestly unify.

    See samples/OpenTok.Sample.Telecom.Android for the other half.
  -->
  <PropertyGroup>
    <OpenTokSdkBand Condition=" '$(OpenTokSdkBand)' == '' ">net9</OpenTokSdkBand>
    <TargetFrameworks Condition=" '$(OpenTokSdkBand)' == 'net9' ">net9.0-ios18.0</TargetFrameworks>
    <TargetFrameworks Condition=" '$(OpenTokSdkBand)' == 'net10' ">net10.0-ios26.0</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>OpenTok.Sample.CallKit.iOS</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <CheckEolWorkloads>false</CheckEolWorkloads>

    <ApplicationTitle>OpenTok CallKit</ApplicationTitle>
    <ApplicationId>com.sbokatuk.opentok.sample.callkit</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion>$(OpenTokSupportedIosVersion)</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />
    <MauiFont Include="Resources\Fonts\*" />
  </ItemGroup>

  <PropertyGroup>
    <OpenTokPackageVersion Condition=" '$(OpenTokPackageVersion)' == '' ">$(VersionPrefix)</OpenTokPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.9" />

    <!-- Exact versions, in brackets — see the cross-platform sample for why. -->
    <PackageReference Include="OpenTok.Net" Version="[$(OpenTokPackageVersion)]" />
    <PackageReference Include="OpenTok.Net.Maui" Version="[$(OpenTokPackageVersion)]" />
  </ItemGroup>

</Project>
