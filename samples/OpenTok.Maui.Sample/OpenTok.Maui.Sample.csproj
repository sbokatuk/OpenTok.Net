<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>$(OpenTokTargetFrameworks)</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>OpenTok.Maui.Sample</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- An app, not a library - Directory.Build.props turns this on for the packed façade. -->
		<GenerateDocumentationFile>false</GenerateDocumentationFile>

		<!-- Display name -->
		<ApplicationTitle>OpenTok.Net Sample</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.sbokatuk.opentoknet.sample</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">$(OpenTokSupportedIosVersion)</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">$(OpenTokSupportedAndroidVersion)</SupportedOSPlatformVersion>

		<!--
			The packed OpenTok.Net version this sample builds against. CI passes it explicitly
			(-p:OpenTokPackageVersion=...) so the sample always compiles against the packages just
			built in the same run, not whatever last landed on nuget.org - see the "sample" job in
			.github/workflows/build.yml. Locally it falls back to this repository's own current
			VersionPrefix, so `dotnet build` works right after `build/BuildNugets.sh` with no extra
			flags, as long as that version is present in ./artifacts (NuGet.config's local-artifacts
			source).
		-->
		<OpenTokPackageVersion Condition=" '$(OpenTokPackageVersion)' == '' ">$(VersionPrefix)</OpenTokPackageVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.0" />
		<!--
			The umbrella package, not OpenTok.Net.iOS/.Android directly - this is what a consumer is
			meant to install, and building the sample against it is what actually verifies the
			per-head PackageReference in OpenTok.Net.csproj resolves correctly on each platform.
		-->
		<PackageReference Include="OpenTok.Net" Version="$(OpenTokPackageVersion)" />
	</ItemGroup>

</Project>
