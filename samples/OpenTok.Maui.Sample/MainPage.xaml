<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:OpenTok.Maui.Sample"
             x:Class="OpenTok.Maui.Sample.MainPage"
             Title="OpenTok.Net">

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Padding="16" RowSpacing="12">

        <Label Grid.Row="0"
               Text="OpenTok Video for .NET MAUI"
               FontSize="22"
               FontAttributes="Bold" />

        <VerticalStackLayout Grid.Row="1" Spacing="8">
            <Entry x:Name="ApiKeyEntry" Placeholder="OpenTok API key" />
            <Entry x:Name="SessionIdEntry" Placeholder="session id" />
            <Entry x:Name="TokenEntry" Placeholder="token" />
        </VerticalStackLayout>

        <!--
          Both views exist for the whole session: creating one on demand would mean creating a
          native renderer mid-layout, which neither SDK expects.
        -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="8">
            <local:OpenTokVideoView x:Name="LocalView" Grid.Column="0" />
            <local:OpenTokVideoView x:Name="RemoteView" Grid.Column="1" />
        </Grid>

        <HorizontalStackLayout Grid.Row="3" Spacing="8" HorizontalOptions="Center">
            <Button x:Name="ConnectButton" Text="Connect" Clicked="OnConnectClicked" />
            <Button x:Name="DisconnectButton" Text="Disconnect" Clicked="OnDisconnectClicked" IsEnabled="False" />
            <Button x:Name="PublishButton" Text="Publish" Clicked="OnPublishClicked" IsEnabled="False" />
        </HorizontalStackLayout>

        <ScrollView Grid.Row="4" x:Name="StatusScroll" HeightRequest="120">
            <Label x:Name="StatusLabel" FontSize="12" />
        </ScrollView>

    </Grid>

</ContentPage>
