<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:opentok="clr-namespace:OpenTok.Net.Maui;assembly=OpenTok.Net.Maui"
             x:Class="OpenTok.Sample.Maui.MainPage"
             Title="OpenTok.Net">

    <!--
      One layout for iOS and Android, and every feature below is driven by the same C#. Compare
      with the two per-platform samples in the binding repositories, which need a hand-written
      video-view handler each and two different delegate models.
    -->
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <VerticalStackLayout Spacing="8">
                <Entry x:Name="ApiKeyEntry" Placeholder="OpenTok API key" Keyboard="Numeric" />
                <Entry x:Name="SessionIdEntry" Placeholder="session id" />
                <Entry x:Name="TokenEntry" Placeholder="token" />
            </VerticalStackLayout>

            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                <Button x:Name="ConnectButton" Text="Connect" Clicked="OnConnectClicked" />
                <Button x:Name="DisconnectButton" Text="Disconnect" Clicked="OnDisconnectClicked" IsEnabled="False" />
                <Button x:Name="PublishButton" Text="Publish" Clicked="OnPublishClicked" IsEnabled="False" />
            </HorizontalStackLayout>

            <!-- Local preview, with the audio level the publisher reports beside it. -->
            <Label Text="Local" FontAttributes="Bold" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <opentok:OpenTokVideoView x:Name="LocalView" Grid.Column="0" HeightRequest="180" />
                <ProgressBar x:Name="LocalLevel" Grid.Column="1" Rotation="270" WidthRequest="160" />
            </Grid>

            <!--
              Camera controls. Every one of these is a single cross-platform property; the two
              SDKs disagree about all of them underneath — Android has no "select this camera"
              call at all, only "cycle".
            -->
            <Label Text="Camera" FontAttributes="Bold" />
            <HorizontalStackLayout Spacing="8">
                <Button x:Name="SwapCameraButton" Text="Swap" Clicked="OnSwapCameraClicked" IsEnabled="False" />
                <Button x:Name="TorchButton" Text="Torch on" Clicked="OnTorchClicked" IsEnabled="False" />
                <Button x:Name="MuteButton" Text="Mute" Clicked="OnMuteClicked" IsEnabled="False" />
            </HorizontalStackLayout>
            <Label x:Name="ZoomLabel" Text="Zoom 1.0×" FontSize="12" TextColor="Gray" />
            <Slider x:Name="ZoomSlider" Minimum="1" Maximum="5" Value="1"
                    ValueChanged="OnZoomChanged" IsEnabled="False" />

            <!--
              Background transformers. These need OpenTok.Net.Transformers.iOS /
              OpenTok.Net.Transformers.Android, which this sample deliberately does NOT reference —
              see MainPage.xaml.cs. The buttons are here to show the API and to demonstrate what
              the failure looks like without the package.
            -->
            <Label Text="Background (needs the transformers package)" FontAttributes="Bold" />
            <HorizontalStackLayout Spacing="8">
                <Button x:Name="BlurButton" Text="Blur" Clicked="OnBlurClicked" IsEnabled="False" />
                <Button x:Name="NoiseButton" Text="Suppress noise" Clicked="OnNoiseClicked" IsEnabled="False" />
                <Button x:Name="ClearTransformersButton" Text="Clear" Clicked="OnClearTransformersClicked" IsEnabled="False" />
            </HorizontalStackLayout>

            <!--
              Multiparty: one view per remote stream, created as the streams arrive rather than a
              single fixed remote view.
            -->
            <Label x:Name="RemoteHeading" Text="Remote (0)" FontAttributes="Bold" />
            <VerticalStackLayout x:Name="RemoteViews" Spacing="8" />

            <!-- Signalling: the SDKs' general-purpose message channel, used here as text chat. -->
            <Label Text="Chat" FontAttributes="Bold" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry x:Name="MessageEntry" Grid.Column="0" Placeholder="message"
                       Completed="OnSendClicked" IsEnabled="False" />
                <Button x:Name="SendButton" Grid.Column="1" Text="Send"
                        Clicked="OnSendClicked" IsEnabled="False" />
            </Grid>

            <Label Text="Log" FontAttributes="Bold" />
            <ScrollView x:Name="StatusScroll" HeightRequest="160">
                <Label x:Name="StatusLabel" FontSize="12" />
            </ScrollView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
