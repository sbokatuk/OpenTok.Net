<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:opentok="clr-namespace:OpenTok.Net.Maui;assembly=OpenTok.Net.Maui"
             x:Class="OpenTok.Sample.Maui.MainPage"
             Title="OpenTok.Net">

    <!--
      One layout for iOS and Android. Compare with the two per-platform samples in the binding
      repositories, which need a hand-written video-view handler each: here OpenTokVideoView comes
      from the package and its Source is set to a publisher or subscriber directly.
    -->
    <Grid RowDefinitions="Auto,*,Auto,Auto" Padding="16" RowSpacing="12">

        <VerticalStackLayout Grid.Row="0" Spacing="8">
            <Entry x:Name="ApiKeyEntry" Placeholder="OpenTok API key" Keyboard="Numeric" />
            <Entry x:Name="SessionIdEntry" Placeholder="session id" />
            <Entry x:Name="TokenEntry" Placeholder="token" />
        </VerticalStackLayout>

        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="8">
            <opentok:OpenTokVideoView x:Name="LocalView" Grid.Column="0" />
            <opentok:OpenTokVideoView x:Name="RemoteView" Grid.Column="1" />
        </Grid>

        <HorizontalStackLayout Grid.Row="2" Spacing="8" HorizontalOptions="Center">
            <Button x:Name="ConnectButton" Text="Connect" Clicked="OnConnectClicked" />
            <Button x:Name="DisconnectButton" Text="Disconnect" Clicked="OnDisconnectClicked" IsEnabled="False" />
            <Button x:Name="PublishButton" Text="Publish" Clicked="OnPublishClicked" IsEnabled="False" />
        </HorizontalStackLayout>

        <ScrollView Grid.Row="3" x:Name="StatusScroll" HeightRequest="120">
            <Label x:Name="StatusLabel" FontSize="12" />
        </ScrollView>

    </Grid>

</ContentPage>
