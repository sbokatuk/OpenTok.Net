<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--
      clear first: without it the machine-wide NuGet.config's sources are appended, and the local
      feeds below stop being authoritative for the packages they carry.
    -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />

    <!--
      This repository's own packed output, so the sample and the package tests restore the .nupkg
      rather than the projects — they exercise exactly what gets published.
    -->
    <add key="local-artifacts" value="artifacts" />

    <!--
      The two platform binding repositories' packed output, as sibling checkouts.

      This is what makes it possible to develop the façade against an unreleased binding change:
      pack OpenTok.Net.iOS or OpenTok.Net.Android locally and it is picked up here without
      publishing anything. Missing directories are ignored by NuGet, so a checkout with no siblings
      still restores — from nuget.org, which is the right fallback.
    -->
    <add key="local-opentok-ios" value="../OpenTok.Net.iOS/artifacts" />
    <add key="local-opentok-android" value="../OpenTok.Net.Android/artifacts" />
  </packageSources>
</configuration>
