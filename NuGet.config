<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--
      clear first: without it the machine-wide NuGet.config's sources are appended, and the local
      feeds below stop being authoritative for the packages they carry.
    -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />

    <!--
      This repository's own packed output, so the sample and the package tests restore the .nupkg
      rather than the projects — they exercise exactly what gets published.
    -->
    <!--
      artifacts/ is committed (as artifacts/.gitkeep) precisely so this source resolves in a fresh
      clone. NuGet does *not* skip a local source whose directory is missing — it fails the whole
      restore with NU1301 — so a local source has to be one that always exists.
    -->
    <add key="local-artifacts" value="artifacts" />

    <!--
      The two platform binding repositories' packed output are deliberately NOT listed here.

      They used to be, as ../OpenTok.Net.iOS/artifacts and ../OpenTok.Net.Android/artifacts, on the
      assumption that NuGet ignores a local source that does not exist. It does not: restore fails
      outright with NU1301. That made this file work only on a machine with all three repositories
      checked out side by side — CI failed at the first restore, and so would any fresh clone.

      To develop the façade against an unreleased binding change, add the sibling feeds *outside*
      this repository, in a NuGet.config one directory up:

        <?xml version="1.0" encoding="utf-8"?>
        <configuration>
          <packageSources>
            <add key="local-opentok-ios" value="OpenTok.Net.iOS/artifacts" />
            <add key="local-opentok-android" value="OpenTok.Net.Android/artifacts" />
          </packageSources>
        </configuration>

      NuGet merges configuration walking up the directory tree, so those sources apply here without
      being committed — and they sit next to the checkouts they describe, which is the only place
      that knows whether those directories exist.
    -->
  </packageSources>
</configuration>
