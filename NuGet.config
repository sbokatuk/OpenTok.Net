<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!--
      Locally packed OpenTok.Net packages. The package tests, the device tests and the sample all
      reference the packed .nupkg rather than the projects, so all three run against exactly what
      gets published - including the inter-package dependencies a ProjectReference would bypass.
    -->
    <add key="local-artifacts" value="artifacts" />
  </packageSources>
</configuration>
