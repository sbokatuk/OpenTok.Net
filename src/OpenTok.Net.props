<!--
  Everything the two façade projects in this repository have in common: the target framework
  matrix, the platform floors, and the packaging metadata.

  Imported explicitly by each .csproj rather than picked up as a Directory.Build.props, matching
  src/OpenTok.Binding.props in the Android binding repository — and for the same reason: a
  Directory.Build.props is imported before the project body, so it cannot read properties the
  project sets.
-->
<Project>

  <PropertyGroup>
    <!--
      Six target frameworks, two platforms, and no single .NET SDK that can build them all.

      Each SDK band ships reference packs for the current target framework and the previous one:
      the .NET 9 band covers net8.0 + net9.0, the .NET 10 band covers net9.0 + net10.0. So
      build/BuildNugets.sh packs twice and merges the results with build/merge-packages.py —
      the same scheme both platform binding repositories use. OpenTokSdkBand selects the pass.

      Platform versions are pinned rather than left to the workload default, because they end up in
      the lib/<tfm>/ folder name inside the package: a bare 'net8.0-ios' silently becomes whatever
      the installed workload currently defaults to, so a workload update would change the package's
      advertised target frameworks with no source edit. They are also pinned to exactly what the
      two wrapped packages advertise — a façade offering a target framework its dependency does not
      carry fails to restore, and does so only for whoever picks that framework.
    -->
    <OpenTokSdkBand Condition=" '$(OpenTokSdkBand)' == '' ">net9</OpenTokSdkBand>
    <TargetFrameworks Condition=" '$(OpenTokSdkBand)' == 'net9' ">net8.0-android34.0;net9.0-android35.0;net8.0-ios18.0;net9.0-ios18.0</TargetFrameworks>
    <TargetFrameworks Condition=" '$(OpenTokSdkBand)' == 'net10' ">net10.0-android36.0;net10.0-ios26.0</TargetFrameworks>

    <!--
      Windows, appended to whichever band is being built, and only on Windows.

      Unlike ios and android, a -windows target framework needs no workload — just the Windows SDK
      reference pack, which every band carries — so it does not have to be split across the two
      passes and net8/net9/net10 can each go in their own band's list.

      Conditioned on the host OS because a -windows target framework cannot be built anywhere else,
      and the packing machine for this repository is a Mac (both other platform heads need Xcode).
      A package built there simply has no Windows assets; that is a real gap, and
      build/BuildNugets.sh is where it has to be closed, not here.
    -->
    <TargetFrameworks Condition=" '$(OpenTokSdkBand)' == 'net9' AND $([MSBuild]::IsOSPlatform('Windows')) ">$(TargetFrameworks);net8.0-windows$(OpenTokWindowsSdkVersion);net9.0-windows$(OpenTokWindowsSdkVersion)</TargetFrameworks>
    <TargetFrameworks Condition=" '$(OpenTokSdkBand)' == 'net10' AND $([MSBuild]::IsOSPlatform('Windows')) ">$(TargetFrameworks);net10.0-windows$(OpenTokWindowsSdkVersion)</TargetFrameworks>

    <!--
      net8.0-* is past end of support, which the SDK reports as an error. It ships deliberately:
      both platform packages carry it, and a large share of MAUI apps are still on .NET 8.
    -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <CheckEolWorkloads>false</CheckEolWorkloads>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>true</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <Target Name="ValidateOpenTokSdkBand" BeforeTargets="Build;Pack" Condition=" '$(TargetFrameworks)' == '' ">
    <Error Text="OpenTokSdkBand must be 'net9' or 'net10', but was '$(OpenTokSdkBand)'." />
  </Target>

  <!--
    Each platform's floor is its native SDK's, taken from Directory.Build.props so that the
    packages, the sample and the device tests cannot disagree. Set per target framework identifier
    rather than once, because they differ.
  -->
  <PropertyGroup Condition=" $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' ">
    <SupportedOSPlatformVersion>$(OpenTokSupportedIosVersion)</SupportedOSPlatformVersion>
  </PropertyGroup>

  <PropertyGroup Condition=" $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' ">
    <SupportedOSPlatformVersion>$(OpenTokSupportedAndroidVersion)</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!--
    Windows 10 build 17763 is .NET MAUI's own floor, and it is deliberately lower than the
    10.0.19041 the target framework is *built* against. That split is the normal Windows pattern:
    TargetPlatformVersion says which APIs may be referenced, SupportedOSPlatformVersion says where
    the result will run. WinUI needs 19041 to build and MAUI supports 17763 at runtime, so a floor
    of 19041 here would refuse to install on machines MAUI itself supports.
  -->
  <PropertyGroup Condition=" $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' ">
    <SupportedOSPlatformVersion>$(OpenTokSupportedWindowsVersion)</SupportedOSPlatformVersion>
    <UseWinUI>true</UseWinUI>
  </PropertyGroup>

  <!--
    Per-platform sources, selected by folder rather than by #if.

    The default globs would compile every Platforms/ folder into every target framework, so they
    are removed first and re-added per platform. This is the standard .NET MAUI single-project
    layout, used here in plain class libraries for the same reason: a file under Platforms/Android
    can use Android.Views.View unguarded, which is a great deal more readable than the same code
    wrapped in #if ANDROID.
  -->
  <ItemGroup>
    <Compile Remove="Platforms/**/*.cs" />
  </ItemGroup>

  <ItemGroup Condition=" $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' ">
    <Compile Include="Platforms/iOS/**/*.cs" />
  </ItemGroup>

  <ItemGroup Condition=" $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' ">
    <Compile Include="Platforms/Android/**/*.cs" />
  </ItemGroup>

  <ItemGroup Condition=" $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' ">
    <Compile Include="Platforms/Windows/**/*.cs" />
  </ItemGroup>

  <!-- Packaging -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageTags>OpenTok;Tokbox;Vonage;SDK;MAUI;iOS;Android;VideoCall;WebRTC;streaming</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../build/icon.png" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)../LICENSE" Pack="true" PackagePath="licenses/" Visible="false" />
  </ItemGroup>

</Project>
